<?xml version="1.0" encoding="UTF-8"?>

        



<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
  
           <bean id="petrolEng" class="in.anilit.beans.PetrolEngine" />

	<bean id="dieselEng" class="in.anilit.beans.DieselEngine" />

	<bean id="car" class="in.anilit.beans.Car">
		<property name="eng" ref="dieselEng" />
		<constructor-arg name="eng" ref="petrolEng" />
	</bean>
        
           
           
           
           
           
           
</beans>
